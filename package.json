{
    "name": "vip-fish-prawn-crab-service",
    "version": "1.0.0",
    "main": "./src/app.js",
    "repository": "https://git3.nexdev.net/l1/game-services/vip-fish-prawn-crab-service.git",
    "author": "pentagon",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "test": "jest",
        "test-coverage": "jest --collect-coverage",
        "dev": "nodemon --es-module-specifier-resolution=node --watch ./src ./src/app.js",
        "debug": "nodemon --es-module-specifier-resolution=node --watch ./ --inspect ./src/app.js",
        "prod": "node --max-old-space-size=8192 --es-module-specifier-resolution=node ./src/app.js",
        "reg": "npm set registry http://npm.lumigame.com",
        "stats": "nodemon --es-module-specifier-resolution=node --watch ./tests ./tests/results.js"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "dependencies": {
        "chance": "^1.1.7",
        "random": "^2.2.0",
        "random-js": "^2.1.0",
        "lodash": "^4.17.19",
        "random-int": "^3.0.0",
        "sc-game-base": "4.1.0",
        "sc-instrument": "1.1.1"
    },
    "resolutions": {
        "sc-base-apis": "1.18.2",
        "sc-base-database": "1.11.1",
        "socket.io-parser": "4.0.5",
        "mongoose": "5.13.20"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.12.11",
        "@commitlint/cli": "^20.0.0",
        "@commitlint/config-conventional": "^9.1.2",
        "@types/jest": "29.5.12",
        "babel-jest": "29.7.0",
        "husky": "^4.2.5",
        "install": "^0.13.0",
        "jest": "29.7.0",
        "jest-extended": "4.0.2",
        "jest-micro-auto-stub": "1.0.9",
        "jest-sonar-reporter": "2.0.0",
        "nodemon": "^2.0.4"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
